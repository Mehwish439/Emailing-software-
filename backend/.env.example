# === Django core ===
SECRET_KEY=change-me-to-a-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# === Database (Supabase PostgreSQL) ===
# Find this under your Supabase project -> Settings -> Database -> Connection string.
# Prefer the "Connection pooling" (pgbouncer) connection for local development.
# Format:
# postgresql://USER:PASSWORD@HOST:PORT/DATABASE_NAME
DATABASE_URL="postgresql://postgres.fyknbzcllbffzxxfrbqs:1sDb8pdGNFfGgxWM@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres"

# === Brevo ===
BREVO_API_KEY=BREVO_API_KEY=your_brevo_api_key_here
BREVO_WEBHOOK_SECRET=HFUeryQlu59y4bqCvldohKsFcz1uws1etIZB1DKCzVE
BREVO_SENDER_NAME=QRM
BREVO_SENDER_EMAIL=noreply@qualityresource.net
# === Frontend ===
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

# === JWT ===
ACCESS_TOKEN_LIFETIME_MINUTES=30
REFRESH_TOKEN_LIFETIME_DAYS=7

# === Timezone ===
TIME_ZONE=Asia/Karachi

# === Scheduling ===
CRON_SECRET=your-cron-secret

# =============================================================================
# === Email provider + self-hosted SMTP (Postfix)  -- NEW, all optional ======
# Brevo settings above are unchanged and keep working. Leaving everything below blank/default
# means "behave exactly as before" (EMAIL_PROVIDER=brevo, no quotas, no rate limit).
# =============================================================================
# Fallback provider when the platform admin has not chosen one: brevo | smtp
EMAIL_PROVIDER=brevo

# Self-hosted SMTP server (see deployment/self-hosted-smtp/README.md). Use EITHER STARTTLS (587) OR implicit TLS (465).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=True
SMTP_USE_SSL=False
SMTP_TIMEOUT=20
SMTP_FROM_EMAIL=
SMTP_REPLY_TO=
# Software-side cap, messages/minute, used when the platform admin has not set a rate. 0 = no cap.
# Must reflect your HOSTING PROVIDER'S WRITTEN limits.
SMTP_RATE_LIMIT=0
SMTP_MAX_RETRIES=3
# Bounce handling: domain whose MX points at the SMTP server, and the shared HMAC secret the
# bounce-forwarder signs requests with (same value as BOUNCE_WEBHOOK_SECRET_FILE's contents on the SMTP server).
SMTP_BOUNCE_DOMAIN=
SMTP_BOUNCE_WEBHOOK_SECRET=

# === Optional Celery + Redis (leave blank to keep the existing cron-driven processing) ===
# Redis must NOT be exposed publicly. Use a private network or a password: redis://:PASSWORD@HOST:6379/0
CELERY_BROKER_URL=

# How many Brevo send attempts per recipient (immediate retries; permanent 4xx errors are never retried).
BREVO_MAX_SEND_ATTEMPTS=2

# --- Added in this upgrade (backend-only; none of these may ever go into a Vite/frontend variable) ---
# Invitation / password-reset emails (sent via Brevo transactional API when BREVO_API_KEY is set)
SEND_INVITE_EMAILS=True
# Soft bounces: suppress after N consecutive soft bounces inside the window (0 disables)
SOFT_BOUNCE_SUPPRESS_THRESHOLD=3
SOFT_BOUNCE_WINDOW_DAYS=30
# Set False on multi-tenant deployments so accounts come only from invitations
ALLOW_PUBLIC_REGISTRATION=True
# Production hardening (used when DEBUG=False)
SECURE_HSTS_SECONDS=0
SECURE_SSL_REDIRECT=False

# Self-service company sign-up (creates a Company + first Company Admin on a LIMITED trial plan)
ALLOW_COMPANY_SIGNUP=True
TRIAL_PLAN_NAME=Trial
TRIAL_DAILY_QUOTA=100
TRIAL_MONTHLY_QUOTA=1000
TRIAL_MAX_USERS=3
