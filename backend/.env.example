# === Django core ===
SECRET_KEY=change-me-to-a-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# === Database (Supabase PostgreSQL) ===
# Find this under your Supabase project -> Settings -> Database -> Connection string.
# Prefer the "Connection pooling" (pgbouncer) connection for local development.
# Format:
# postgresql://USER:PASSWORD@HOST:PORT/DATABASE_NAME
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE_NAME

# === Brevo ===
BREVO_API_KEY=your-brevo-api-key
BREVO_WEBHOOK_SECRET=your-brevo-webhook-secret
BREVO_SENDER_NAME=Your Sender Name
BREVO_SENDER_EMAIL=no-reply@example.com

# === Frontend ===
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

# === JWT ===
ACCESS_TOKEN_LIFETIME_MINUTES=30
REFRESH_TOKEN_LIFETIME_DAYS=7

# === Timezone ===
TIME_ZONE=Asia/Karachi

# === Scheduling ===
CRON_SECRET=your-cron-secret