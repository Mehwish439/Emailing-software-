# Rotate MailFlow's own logs. (Postfix's /var/log/mail.log is rotated by Ubuntu's rsyslog logrotate rule;
# at high volume lower its "rotate"/switch to daily in /etc/logrotate.d/rsyslog.)
/var/log/mailflow-smtp/*.log {
    weekly
    rotate 8
    compress
    delaycompress
    missingok
    notifempty
    create 0640 mailflow mailflow
}
