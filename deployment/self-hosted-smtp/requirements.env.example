# =============================================================================
# MailFlow self-hosted SMTP (Postfix + OpenDKIM) -- configuration
# Copy to `requirements.env`, edit EVERY value marked CHANGE_ME, then chmod 600.
# NEVER commit requirements.env. It contains no passwords by default: secrets live in
# root-only files under /etc/mailflow-smtp/secrets/ that the scripts create for you.
# =============================================================================

# ---- Identity (all REQUIRED) -------------------------------------------------
# Public hostname of THIS server. Needs an A record, and the server's IP needs a matching PTR (rDNS).
SMTP_HOSTNAME=mail.send.CHANGE_ME.example
# Domain/subdomain you send FROM (the domain in your campaigns' From address). SPF/DKIM/DMARC live here.
SENDING_DOMAIN=send.CHANGE_ME.example
# Extra domains this server may sign + send for, comma separated (SENDING_DOMAIN is always included).
EXTRA_SENDING_DOMAINS=
# Domain whose MX points at this server to receive bounces (VERP return-paths). Must differ from SENDING_DOMAIN.
BOUNCE_DOMAIN=bounce.CHANGE_ME.example
# Where Postfix sends operational mail (postmaster/abuse aliases). A mailbox you actually read.
ADMIN_EMAIL=postmaster@CHANGE_ME.example
# This server's PUBLIC IPv4 (used by DNS/rDNS validation; never auto-detected over the network).
SMTP_PUBLIC_IP=CHANGE_ME
# Public IPs of the machines allowed to submit mail on port 587 (your Django/Render egress IPs), comma separated.
# On Render, outbound IPs are shared/documented per region -- see README "Connecting the application".
APP_SERVER_IPS=CHANGE_ME

# ---- Application account (the Django app authenticates with this) ------------
SMTP_AUTH_USER=mailflow-app
# Leave the password file path as is; configure-postfix.sh creates a random password there on first run
# (mode 600, root only) and NEVER prints it. Read it once with `sudo cat` to copy into Django's SMTP_PASSWORD.
SMTP_AUTH_PASSWORD_FILE=/etc/mailflow-smtp/secrets/smtp-auth-password

# ---- TLS ---------------------------------------------------------------------
# letsencrypt = obtain a certificate with certbot (needs port 80 reachable once, DNS A record in place)
# existing    = use TLS_CERT_FILE / TLS_KEY_FILE you provide
TLS_CERT_MODE=letsencrypt
LETSENCRYPT_EMAIL=CHANGE_ME@example.com
TLS_CERT_FILE=
TLS_KEY_FILE=

# ---- DKIM --------------------------------------------------------------------
DKIM_SELECTOR=mf1
DKIM_KEY_BITS=2048

# ---- Rate / queue controls (SET FROM YOUR HOST'S WRITTEN POLICY, not wishful thinking) -------------
# Max messages per minute accepted from the app (anvil). 0 disables. This is the GLOBAL ingress cap.
GLOBAL_RATE_PER_MINUTE=25
# Parallel connections to any one receiving domain, and the pause between messages to it.
DEST_CONCURRENCY=2
DEST_RATE_DELAY=1s
# Optional per-destination-domain pacing: domain=delay,... e.g. gmail.com=2s,yahoo.com=3s,outlook.com=2s
# Each distinct delay becomes its own Postfix transport with concurrency 1.
PER_DOMAIN_RATE_DELAY=
# How long Postfix keeps retrying a deferred message before bouncing it.
MAX_QUEUE_LIFETIME=2d
MESSAGE_SIZE_LIMIT=26214400

# ---- Network / firewall ------------------------------------------------------
INET_PROTOCOLS=ipv4
SSH_PORT=22
# Optional: restrict SSH to this CIDR (empty = any). Strongly recommended.
SSH_ALLOW_FROM=

# ---- Health thresholds (health-check.sh) ---------------------------------------
HEALTH_DISK_WARN_PCT=80
HEALTH_DISK_CRIT_PCT=90
HEALTH_QUEUE_WARN=500
HEALTH_QUEUE_CRIT=5000
HEALTH_CERT_WARN_DAYS=14

# ---- Bounce forwarding (optional but recommended) ----------------------------
# Your Django API's bounce intake URL and the shared HMAC secret (same value as Django's
# SMTP_BOUNCE_WEBHOOK_SECRET). The secret itself is stored in a root-only file, not here.
BOUNCE_WEBHOOK_URL=https://CHANGE_ME.example/api/providers/smtp/bounce/
BOUNCE_WEBHOOK_SECRET_FILE=/etc/mailflow-smtp/secrets/bounce-webhook-secret
